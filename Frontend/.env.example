# ============================================================
# ATS Fleet Management Platform - Frontend Environment Variables
# ============================================================

# Backend API URL. Use the local URL only in a local development .env file.
# Production must use the deployed backend URL (or a same-origin API proxy).
VITE_API_URL=

# Supabase Auth configuration required for sign-in and protected backend APIs.
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
