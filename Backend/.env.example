# ============================================================
# ATS Fleet Management Platform - Backend Environment Variables
# ============================================================

# Wialon Telematics Credentials
# Replace with your production Wialon Token and API Gateway URL
WIALON_TOKEN=your_wialon_sdk_token_here
WIALON_API=https://hst-api.wialon.com/wialon/ajax.html

# Supabase Auth configuration (server-side; never add a service role key to VITE_*)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Set to the exact deployed frontend origin(s), comma-separated. Leave blank in production
# until the Vercel deployment origin is known. Localhost is enabled only in development.
CORS_ORIGINS=

# Groq AI Assistant
GROQ_API_KEY=your_groq_api_key_here

# Supabase Service Role Key (for background admin/import tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
