# ============================================================
# ATS Fleet Management Platform — .gitignore
# ============================================================

# ── Environment & Secrets (NEVER commit) ─────────────────────
.env
.env.*
!.env.example
*.local

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# ── Virtual Environments ──────────────────────────────────────
venv/
.venv/
env/
Backend/venv/
Backend/.venv/

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
Frontend/node_modules/
dist/
Frontend/dist/
dist-ssr/
build/
.vite/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temporary / Cache ────────────────────────────────────────
*.tmp
*.temp
*.cache
.cache/

# ── Local database backups (real fuel data; never commit) ────
Backend/db_backups/
*.dump
*.pgdump
# ── Generated code graph (rebuilt locally by graphify) ───────
graphify-out/
